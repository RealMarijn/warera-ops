{
  "manifest_version": 3,
  "name": "WarEra Ops",
  "version": "0.1.0",
  "description": "Adds extra API-powered stats (like Bounty rank) to WarEra profile pages.",
  "browser_specific_settings": {
    "gecko": {
      "id": "warera-ops@local.extension"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WarEra Ops",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api2.warera.io/*",
    "https://api3.warera.io/*",
    "https://api4.warera.io/*",
    "https://api5.warera.io/*",
    "https://api6.warera.io/*"
  ],
  "action": {
    "default_popup": "menu.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://app.warera.io/*"],
      "js": ["browser-polyfill.js", "common.js", "rankings.js", "country-rankings.js", "mu-rankings.js", "inventory-export.js", "battle-money-totals.js", "market-order-totals.js", "account-inventory-value.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.warera.io/*"],
      "js": ["tools/dmg-lines/hook.js", "tools/dmg-lines/map.js", "tools/sr-map/sr-map.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.warera.io/*"],
      "js": ["tools/dmg-lines/overlay.js", "tools/sr-map/sr-overlay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/images/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
